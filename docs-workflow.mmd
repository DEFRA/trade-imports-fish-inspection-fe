flowchart TD
    subgraph Author["1. Create or update docs (local)"]
        A1["Request to document a feature, route, or config"] --> A2["Trace code, config, and tests<br/>(implementation is source of truth)"]
        A2 --> A3{"Existing doc in docs/ covers it?"}
        A3 -- Yes --> A4["Update doc in place"]
        A3 -- No --> A5["Create docs/topic.md<br/>front matter: layout: page, title, description"]
        A4 --> A6["Update docs/index.md links"]
        A5 --> A6
        A6 --> A7["Check links, Nunjucks escaping, npx eleventy builds"]
    end

    subgraph Preview["2. Preview with Eleventy (local)"]
        B1["npm run docs:serve"] --> B2["Eleventy reads docs/ as input<br/>Nunjucks renders Markdown<br/>govuk plugin applies layout and search"]
        B2 --> B3["npm run docs:build outputs _site/"]
    end

    Push["Commit and merge to main"]

    subgraph Confluence["3. Publish to Confluence (publish-docs-confluence.yml)"]
        C1["Push to main touching docs/**,<br/>scripts/confluence/**, or the workflow"] --> C2["Checkout with full history<br/>diff BEFORE_SHA..AFTER_SHA"]
        C2 --> C3["publish_confluence.py finds changed Markdown<br/>(rename detection on)"]
        C3 --> C4{"Front matter has confluence.page_id<br/>and publish is not false?"}
        C4 -- No --> C5["Skip document"]
        C4 -- Yes --> C6{"Change type"}
        C6 -- "Added or modified" --> C7["Fetch current page<br/>update with next version number<br/>Markdown converted to HTML, front matter removed"]
        C6 -- "Renamed, same page_id" --> C8["Update mapped page without trashing"]
        C6 -- Deleted --> C9["Read mapping from base commit<br/>apply delete_mode: trash default or retain"]
        C7 --> C10{"Page fetch failed?"}
        C10 -- Yes --> C11["Fail the run<br/>no replacement page created"]
        C10 -- No --> C12["Confluence page updated"]
    end

    subgraph Pages["4. Serve on GitHub Pages (build-eleventy-docs.yml)"]
        D1["Push to main touching docs/**,<br/>eleventy.config.js, package.json, or lock file"] --> D2["npm ci<br/>rm -rf _site<br/>npm run docs:build"]
        D2 --> D3["Upload _site as Pages artifact"]
        D3 --> D4["deploy-pages"]
        D4 --> D5["Live docs site<br/>path prefix /trade-imports-fish-inspection-fe/"]
    end

    A7 --> B1
    A7 --> Push
    Push --> C1
    Push --> D1
    B3 -. "same build as CI" .-> D2
