{% extends "layouts/page.njk" %}

{% set pageName = "Mock sign in" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Test user sign-in</h1>
      <div class="govuk-inset-text">
        For local development and dev/test environments only. Test user sign-in does not verify your identity or contact an identity provider.
      </div>
      <p class="govuk-body">Choose a predefined test user to sign in as.</p>
      <form method="post" action="/mock-auth">
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Sign in as</legend>
            <div class="govuk-radios">
              {% for user in users %}
                <div class="govuk-radios__item">
                  <input class="govuk-radios__input" id="mock-user-{{ user.id }}" name="mockUser" type="radio" value="{{ user.id }}" required>
                  <label class="govuk-label govuk-radios__label" for="mock-user-{{ user.id }}">{{ user.name }} — {{ user.organisationName }}</label>
                </div>
              {% endfor %}
            </div>
          </fieldset>
        </div>
        <button class="govuk-button" type="submit">Continue</button>
      </form>
    </div>
  </div>
{% endblock %}
